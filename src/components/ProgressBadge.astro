---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---
<Default><slot /></Default>
<a
  id="progress-badge"
  href="/lernfortschritt/"
  title="Lernfortschritt anzeigen"
  style="
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low, #1e3a5f);
    color: var(--sl-color-accent-high, #93c5fd);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--sl-color-accent, #3b82f6);
    transition: background 0.2s;
  "
>
  📋 <span id="progress-pct">–%</span>
</a>

<script>
  const STORAGE_KEY = 'cavehub_progress';
  const TOTAL = 17;

  function update() {
    try {
      const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      const done = Object.values(stored).filter(Boolean).length;
      const pct = Math.round((done / TOTAL) * 100);
      const el = document.getElementById('progress-pct');
      if (el) el.textContent = pct + '%';
    } catch {}
  }

  update();
  window.addEventListener('storage', update);
</script>
