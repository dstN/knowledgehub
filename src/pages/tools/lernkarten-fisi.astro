---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: 'AP1 Lernkarten – FISI', description: 'Interaktive Karteikarten zur Prüfungsvorbereitung AP1 Fachinformatik Systemintegration.' }}>
  <p>Karteikarten zur AP1-Vorbereitung — Themenübersicht, interaktives Üben mit Flip-Karten und Alle-Karten-Ansicht.</p>

  <div class="lk">
    <nav class="lk-nav" id="lk-nav">
      <button type="button" class="lk-nav-btn active" data-page="themen">📋 Themenübersicht</button>
      <button type="button" class="lk-nav-btn" data-page="karten">🃏 Karteikarten üben</button>
      <button type="button" class="lk-nav-btn" data-page="alle">📖 Alle Karten ansehen</button>
    </nav>

    <!-- PAGE 1: THEMEN -->
    <div class="lk-page active" id="lk-page-themen">
      <div class="lk-info" style="margin-bottom:12px;">
        <strong style="font-size:15px;">Themengebiete AP1</strong>
        <p style="font-size:13px;color:#94a3b8;margin:4px 0;">Die AP1 ist für alle IT-Berufe identisch. Prüfungsbereich: „Einrichten eines IT-gestützten Arbeitsplatzes" — 90 Minuten, 20 % der Gesamtnote.</p>
        <p style="font-size:12px;color:#f97316;margin:0;">⚠ Ab 2025 gelten neue Inhalte. SQL und RAID wurden aus AP1 gestrichen. KI-Grundlagen wurden neu aufgenommen.</p>
      </div>

      <div class="lk-grid">
        <div class="lk-theme" style="border-top:3px solid #378ADD;">
          <h3>🖥 Hardware</h3>
          <ul><li>CPU, RAM, Speicher, Peripherie</li><li>Virtualisierung, Container</li><li>Schnittstellen (USB, PCIe, SATA)</li><li>P = U × I (Strom, Spannung, Leistung)</li><li>Wirkungsgrad berechnen</li><li>BIOS/UEFI, Treiber</li></ul>
        </div>
        <div class="lk-theme" style="border-top:3px solid #8B5CF6;">
          <h3>💻 Betriebssysteme <span class="lk-new">NEU</span></h3>
          <ul><li>Windows Home/Pro/Enterprise</li><li>Linux-Befehle (CLI)</li><li>Dateisysteme (NTFS, ext4)</li><li>Prozesse vs. Threads</li><li>Benutzerverwaltung</li><li>Backup-Typen, Registry</li></ul>
        </div>
        <div class="lk-theme" style="border-top:3px solid #D4537E;">
          <h3>� Programmierung & KI</h3>
          <ul><li>Variablen, Datentypen, Arrays</li><li>Kontrollstrukturen (if, for, while)</li><li>UML, BPMN, Pseudocode</li><li>Maschinelles Lernen (ML)</li><li>KI-Einsatzbereiche in der IT</li><li>Algorithmen & Komplexität</li></ul>
        </div>
        <div class="lk-theme" style="border-top:3px solid #BA7517;">
          <h3>🌐 Netzwerke</h3>
          <ul><li>OSI-Schichtenmodell (7 Schichten)</li><li>IPv4/IPv6, Subnetting, CIDR</li><li>DHCP, DNS, TCP, UDP</li><li>Frame Relay, MPLS, WAN</li><li>WLAN-Standards (Wi-Fi 6)</li><li>VPN, Firewall, Routing</li></ul>
        </div>
        <div class="lk-theme" style="border-top:3px solid #0D9488;">
          <h3>� Mobilfunk & Satelliten</h3>
          <ul><li>Mobilfunkgenerationen 1G-5G</li><li>Zellprinzip, Basisstationen</li><li>GPS, GLONASS, Galileo, BeiDou</li><li>LEO vs. GEO (Starlink)</li><li>Roaming, EGNOS, IoT</li><li>Frequenzen, Strahlung</li></ul>
        </div>
        <div class="lk-theme" style="border-top:3px solid #E24B4A;">
          <h3>🔒 IT-Sicherheit & Datenschutz</h3>
          <ul><li>CIA-Prinzip (C/I/A)</li><li>DSGVO-Grundsätze & Betroffenenrechte</li><li>Verschlüsselung (sym./asym.)</li><li>Firewall, IDS/IPS, Zugriffsrechte</li><li>Hashing, digitale Signaturen</li><li>Backup-Strategien, Zertifikate</li></ul>
        </div>
        <div class="lk-theme" style="border-top:3px solid #059669;">
          <h3>� Wirtschaft & Management</h3>
          <ul><li>Projektmanagement (Netzplan, Gantt)</li><li>Kostenarten (fix/variable Kosten)</li><li>Leasing, Kauf, Miete, Lizenzmodelle</li><li>Nutzwertanalyse, Amortisation</li><li>Stromkosten berechnen ⭐</li><li>Recht: DSGVO, Vertragsarten</li></ul>
        </div>
        <div class="lk-theme" style="border-top:3px solid #64748b;background:#0f172a;">
          <h3>📝 Prüfungsformat</h3>
          <ul><li>Dauer: 90 Minuten</li><li>Gewichtung: 20 % der Gesamtnote</li><li>Für alle IT-Berufe identisch</li><li>Multiple Choice & offene Fragen</li><li>Belegsatz wird mitgeliefert</li><li>Nach ca. 18 Monaten Ausbildung</li></ul>
        </div>
      </div>
      <p style="margin-top:24px;font-size:12px;color:#64748b;border-top:1px solid #334155;padding-top:12px;">Quelle: ZPA Nordwest Prüfungskatalog (Stand Oktober 2024, gültig ab Frühjahr 2025)</p>
    </div>

    <!-- PAGE 2: KARTEIKARTEN ÜBEN -->
    <div class="lk-page" id="lk-page-karten">
      <p style="font-size:13px;color:#94a3b8;margin-bottom:16px;">Karte anklicken zum Umdrehen. Dann bewerten.</p>
      <div class="lk-filters" id="lk-filters"></div>

      <div class="lk-fc-main">
        <div class="lk-fc-meta">
          <span id="lk-counter"></span>
          <span id="lk-score" style="color:#22d3ee;font-weight:600;"></span>
        </div>
        <div class="lk-prog-wrap"><div class="lk-prog-fill" id="lk-prog"></div></div>

        <div id="lk-card" class="lk-card">
          <span id="lk-cat-tag" class="lk-cat-tag"></span>
          <p id="lk-q" class="lk-q"></p>
          <div id="lk-a" class="lk-a"></div>
          <p id="lk-hint" class="lk-hint">Klicken zum Umdrehen</p>
        </div>

        <div class="lk-btns" id="lk-btn-row" style="display:none;">
          <button type="button" class="lk-btn lk-btn-no" id="lk-rate-no">✗ Nochmal</button>
          <button type="button" class="lk-btn lk-btn-skip" id="lk-skip">→ Überspringen</button>
          <button type="button" class="lk-btn lk-btn-yes" id="lk-rate-yes">✓ Gewusst!</button>
        </div>

        <div id="lk-summary" style="display:none;text-align:center;padding:48px 16px;">
          <h2 id="lk-sum-txt" style="font-size:28px;margin-bottom:8px;"></h2>
          <p style="color:#94a3b8;margin-top:6px;">Runde abgeschlossen!</p>
          <button type="button" class="lk-btn lk-btn-restart" id="lk-restart" style="margin-top:20px;">↺ Neu starten</button>
        </div>
      </div>
    </div>

    <!-- PAGE 3: ALLE KARTEN -->
    <div class="lk-page" id="lk-page-alle">
      <p style="font-size:13px;color:#94a3b8;margin-bottom:16px;">Klicke auf eine Frage, um die Antwort zu sehen.</p>
      <div id="lk-cards-list" class="lk-cards-list"></div>
    </div>
  </div>

  <style is:global>
    .lk { max-width:860px; margin:1.5rem auto; font-family:system-ui,-apple-system,sans-serif; }

    /* Nav tabs – alle Reiter gleich breit, gleich hoch */
    nav.lk-nav {
      display:flex !important;
      gap:0 !important;
      border-bottom:1px solid #334155 !important;
      margin-bottom:1.5rem !important;
      overflow-x:auto !important;
    }
    nav.lk-nav > button.lk-nav-btn {
      flex:1 1 0% !important;
      min-width:0 !important;
      margin:0 !important;
      padding:12px 8px !important;
      font-size:13px !important;
      font-weight:500 !important;
      border:none !important;
      background:none !important;
      cursor:pointer;
      color:#94a3b8 !important;
      border-bottom:2px solid transparent !important;
      white-space:nowrap !important;
      transition:all .15s;
      line-height:1.4 !important;
      display:flex !important;
      align-items:center !important;
      justify-content:center !important;
      height:44px !important;
      box-sizing:border-box !important;
      align-self:stretch !important;
    }
    nav.lk-nav > button.lk-nav-btn.active { color:#e2e8f0 !important; border-bottom-color:#22d3ee !important; }
    nav.lk-nav > button.lk-nav-btn:hover { color:#e2e8f0 !important; }

    /* Pages */
    .lk-page { display:none !important; }
    .lk-page.active { display:block !important; }

    /* Theme grid – alle Boxen gleich hoch pro Zeile */
    div.lk-grid {
      display:grid !important;
      grid-template-columns:repeat(2,1fr) !important;
      gap:14px !important;
      align-items:stretch !important;
    }
    div.lk-grid > div.lk-theme {
      background:#1e293b !important;
      border-radius:10px !important;
      padding:16px !important;
      border:1px solid #334155 !important;
      box-sizing:border-box !important;
      min-height:0 !important;
      margin:0 !important;
      align-self:stretch !important;
    }
    @media (max-width:560px) { div.lk-grid { grid-template-columns:1fr !important; } }
    .lk-theme h3 { font-size:14px !important; font-weight:500 !important; margin-bottom:8px !important; color:#e2e8f0 !important; }
    .lk-theme ul { padding-left:16px !important; font-size:13px !important; color:#94a3b8 !important; line-height:1.8 !important; margin:0 !important; }
    .lk-new { font-size:10px; background:#422006; color:#f97316; padding:2px 7px; border-radius:4px; font-weight:500; vertical-align:middle; margin-left:6px; }

    /* Filter buttons – alle identische Breite */
    div.lk-filters {
      display:grid !important;
      grid-template-columns:repeat(4, 1fr) !important;
      gap:10px !important;
      margin-bottom:16px !important;
    }
    div.lk-filters > button.lk-filter-btn {
      font-size:12px !important;
      padding:8px 6px !important;
      border-radius:20px !important;
      cursor:pointer;
      border:1px solid #475569 !important;
      background:#1e293b !important;
      color:#94a3b8 !important;
      transition:all .1s;
      text-align:center !important;
      width:100% !important;
      height:36px !important;
      margin:0 !important;
      overflow:hidden !important;
      text-overflow:ellipsis !important;
      white-space:nowrap !important;
      box-sizing:border-box !important;
      align-self:center !important;
    }
    div.lk-filters > button.lk-filter-btn.on { background:#e2e8f0 !important; color:#0f172a !important; border-color:#e2e8f0 !important; }

    /* Flashcard */
    .lk-fc-main { max-width:600px; margin:0 auto; }
    .lk-fc-meta { display:flex; justify-content:space-between; font-size:12px; color:#64748b; margin-bottom:10px; }
    .lk-prog-wrap { height:4px; background:#1e293b; border-radius:2px; margin-bottom:16px; }
    .lk-prog-fill { height:4px; background:#22d3ee; border-radius:2px; transition:width .3s; width:0%; }

    .lk-card {
      background:#1e293b; border:1px solid #334155; border-radius:14px;
      min-height:200px; padding:32px 28px; cursor:pointer; text-align:center;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      transition:box-shadow .15s;
    }
    .lk-card:hover { box-shadow:0 4px 16px rgba(0,0,0,.3); }
    .lk-cat-tag { font-size:11px; padding:3px 10px; border-radius:20px; margin-bottom:14px; font-weight:500; }
    .lk-q { font-size:16px; font-weight:500; line-height:1.5; color:#e2e8f0; margin:0; }
    .lk-a { font-size:14px; color:#94a3b8; line-height:1.65; margin-top:18px; padding-top:18px; border-top:1px solid #334155; display:none; }
    .lk-hint { font-size:12px; color:#64748b; margin-top:14px; }

    /* Buttons */
    .lk-btns { display:flex; gap:10px; margin-top:14px; justify-content:center; }
    .lk-btn { padding:10px 20px; border-radius:8px; font-size:13px; font-weight:500; cursor:pointer; border:1px solid; }
    .lk-btn-no  { background:#1c1917; color:#ef4444; border-color:#7f1d1d; }
    .lk-btn-yes { background:#052e16; color:#22c55e; border-color:#14532d; }
    .lk-btn-skip { background:#1e293b; color:#94a3b8; border-color:#475569; }
    .lk-btn-restart { background:#e2e8f0; color:#0f172a; border-color:#e2e8f0; padding:12px 28px; }

    /* All cards list */
    .lk-cards-list {}
    .lk-card-item { background:#1e293b; border-radius:10px; border:1px solid #334155; margin-bottom:10px; overflow:hidden; }
    .lk-card-head {
      padding:12px 16px; cursor:pointer; display:flex; justify-content:space-between; align-items:center;
      font-size:14px; font-weight:500; color:#e2e8f0;
    }
    .lk-card-head:hover { background:#0f172a; }
    .lk-card-body { display:none !important; padding:12px 16px; border-top:1px solid #334155; font-size:13px; color:#94a3b8; line-height:1.65; background:#0f172a; }
    .lk-card-body.open { display:block !important; }
    .lk-cat-pill { font-size:11px; padding:2px 8px; border-radius:10px; margin-right:8px; }
  </style>

  <script>
    (function() {
      var catColors = {
        "Netzwerke": "#BA7517",
        "IT-Sicherheit": "#E24B4A",
        "Hardware": "#378ADD",
        "Programmierung": "#D4537E",
        "Mobilfunk & Satelliten": "#0D9488",
        "Betriebssysteme": "#8B5CF6",
        "Wirtschaft & Management": "#059669"
      };

      var cards = [
        { cat:"Wirtschaft & Management", q:"Was ist der kritische Pfad in einem Projektplan?", a:"Der längste Weg durch den Netzplan — Verzögerungen auf diesem Pfad verschieben direkt den Projektabschluss. Vorgänge auf dem kritischen Pfad haben keine Pufferzeit (Puffer = 0)." },
        { cat:"Wirtschaft & Management", q:"Was ist der Unterschied zwischen Pufferzeit und Meilenstein?", a:"Pufferzeit: zeitlicher Spielraum eines Vorgangs, ohne dass sich der Gesamtplan verzögert. Meilenstein: wichtiger Zwischentermin ohne eigene Dauer — zeigt Projektfortschritt an." },
        { cat:"Wirtschaft & Management", q:"Nenne 4 typische Merkmale eines Projekts.", a:"Einmalig (kein Routinevorgang), zeitlich begrenzt (klares Start- und Enddatum), definiertes Ziel, begrenzte Ressourcen (Budget, Personal, Zeit), oft eigene Projektorganisation." },
        { cat:"Wirtschaft & Management", q:"Was sollte ein Projektauftrag / eine Auftragsunterlage enthalten?", a:"Auftraggeber und Auftragnehmer, Projektziel (was soll erreicht werden?), Leistungsumfang, Termine/Meilensteine, Budget, Ressourcen, rechtliche/wirtschaftliche Rahmenbedingungen." },
        { cat:"Netzwerke", q:"Erkläre das OSI-Modell in 7 Schichten (von unten nach oben).", a:"1 Bitübertragung (Kabel/Funk) → 2 Sicherung (MAC, Switches) → 3 Vermittlung (IP, Router) → 4 Transport (TCP/UDP) → 5 Sitzung → 6 Darstellung (Verschlüsselung, Codierung) → 7 Anwendung (HTTP, FTP, DNS)" },
        { cat:"Netzwerke", q:"Was ist der Unterschied zwischen TCP und UDP?", a:"TCP: verbindungsorientiert, zuverlässig, Handshake, Bestätigung jedes Pakets (langsamer) — z.B. HTTP, FTP, Email. UDP: verbindungslos, kein Handshake, schnell aber unzuverlässig — z.B. Streaming, VoIP, DNS, Gaming." },
        { cat:"Netzwerke", q:"Wie berechnet man die Netzwerkadresse aus IP und Subnetzmaske?", a:"Bitweise AND-Verknüpfung von IP-Adresse und Subnetzmaske. Beispiel: 192.168.10.50 AND 255.255.255.0 = 192.168.10.0 (Netzwerkadresse). Die Broadcast-Adresse ist die letzte Adresse im Netz." },
        { cat:"Netzwerke", q:"Was macht DHCP, was macht DNS?", a:"DHCP (Dynamic Host Configuration Protocol): weist IP-Adressen, Subnetzmaske, Gateway und DNS-Server automatisch zu. DNS (Domain Name System): übersetzt Domainnamen in IP-Adressen — das 'Telefonbuch des Internets'." },
        { cat:"Netzwerke", q:"Welche WLAN-Standards kennst du? Was unterscheidet sie?", a:"IEEE 802.11b/g/n/ac/ax (Wi-Fi 6). Unterschiede: Frequenzband (2,4 GHz vs. 5 GHz), maximale Übertragungsrate, Reichweite, Anzahl unterstützter Geräte. 5 GHz = schneller, weniger Reichweite. 2,4 GHz = mehr Reichweite, stärker belegt." },
        { cat:"IT-Sicherheit", q:"Was bedeutet das CIA-Prinzip in der IT-Sicherheit?", a:"C = Confidentiality (Vertraulichkeit): Daten nur für Berechtigte. I = Integrity (Integrität): Daten dürfen nicht unbemerkt geändert werden. A = Availability (Verfügbarkeit): Systeme müssen erreichbar sein. Die 3 Schutzziele der Informationssicherheit." },
        { cat:"IT-Sicherheit", q:"Nenne 4 DSGVO-Grundsätze.", a:"Zweckbindung (Daten nur für festgelegten Zweck), Datensparsamkeit (nur notwendige Daten), Richtigkeit (aktuelle Daten), Speicherbegrenzung, Integrität & Vertraulichkeit, Transparenz gegenüber Betroffenen, Rechenschaftspflicht." },
        { cat:"IT-Sicherheit", q:"Was ist der Unterschied zwischen symmetrischer und asymmetrischer Verschlüsselung?", a:"Symmetrisch: ein Schlüssel für Ver- und Entschlüsselung (schnell, Problem: sicherer Schlüsselaustausch). Beispiel: AES. Asymmetrisch: öffentlicher Schlüssel zum Verschlüsseln, privater Schlüssel zum Entschlüsseln. Beispiel: RSA. Langsamer, aber kein Schlüsselaustauschproblem." },
        { cat:"IT-Sicherheit", q:"Was ist der Unterschied zwischen einer Firewall und einem Virenscanner?", a:"Firewall: kontrolliert und filtert den Netzwerkverkehr nach Regeln (Ports, IPs, Protokolle) — schützt vor unerlaubten Verbindungen. Virenscanner: erkennt und entfernt Schadsoftware auf dem Gerät. Beide ergänzen sich." },
        { cat:"Wirtschaft & Management", q:"Wie berechnet man den Stromverbrauch in kWh und die Kosten?", a:"Formel: W (kWh) = P (kW) × t (h). Beispiel: 300 Watt PC × 8 Stunden = 2,4 kWh. Kosten = kWh × Preis pro kWh. Amortisation: Mehrkosten teurerer Hardware / Einsparung pro Jahr = Jahre bis Amortisation." },
        { cat:"Wirtschaft & Management", q:"Was ist eine Nutzwertanalyse?", a:"Methode zum qualitativen Vergleich von Alternativen: 1. Kriterien festlegen, 2. Kriterien gewichten (Summe = 100%), 3. Alternativen bewerten (z.B. 1-10), 4. Gewicht × Bewertung für jede Alternative, 5. Summe bilden — höchste Punktzahl gewinnt." },
        { cat:"Wirtschaft & Management", q:"Was sind fixe und variable Kosten? Nenne je ein Beispiel.", a:"Fixe Kosten: entstehen unabhängig von der Nutzungsmenge (z.B. Miete, Grundgebühr, Abschreibungen, Leasingrate). Variable Kosten: steigen mit der Nutzung (z.B. Stromkosten, Verbrauchsmaterial, nutzungsabhängige Lizenzgebühren)." },
        { cat:"Wirtschaft & Management", q:"Wann lohnt sich Leasing gegenüber Kauf?", a:"Leasing vorteilhaft wenn: geringere Anfangsinvestition gewünscht, regelmäßige Modernisierung wichtig, steuerliche Vorteile (Betriebsausgabe), Off-Balance-Sheet. Kauf vorteilhaft wenn: langfristige Nutzung, Eigenkapital vorhanden, keine Abhängigkeit vom Leasinggeber gewünscht." },
        { cat:"Wirtschaft & Management", q:"Nenne 3 gängige Software-Lizenzmodelle.", a:"1. Einzellizenz/OEM: eine Lizenz pro Gerät. 2. Volumenlizenz: Lizenzen für mehrere Geräte, oft mit zentraler Verwaltung. 3. Subscription/Abonnement: zeitlich begrenzte Nutzung (z.B. Microsoft 365), regelmäßige Zahlungen, immer aktuelle Version." },
        { cat:"Wirtschaft & Management", q:"Was ist der Unterschied zwischen Kauf, Miete und Leasing?", a:"Kauf: Eigentumsübertragung, volle Kosten sofort oder raten. Miete: kurzfristige Nutzung, Rückgabe nach Mietzeit. Leasing: langfristige Nutzung wie Miete, oft mit Kaufoption am Ende. Kauf = Bilanzaktiv, Leasing/Miete = Betriebsausgabe." },
        { cat:"Wirtschaft & Management", q:"Was sind die 7 DSGVO-Grundsätze?", a:"1. Rechtmäßigkeit/Fairness, 2. Zweckbindung, 3. Datensparsamkeit, 4. Richtigkeit, 5. Speicherbegrenzung, 6. Integrität/Vertraulichkeit, 7. Rechenschaftspflicht. Plus Betroffenenrechte: Auskunft, Berichtigung, Löschung, Einschränkung, Widerspruch, Datenübertragbarkeit." },
        { cat:"Wirtschaft & Management", q:"Was ist ein Netzplan und was zeigt er?", a:"Graphische Darstellung eines Projektablaufs mit Vorgängen (Knoten) und Abhängigkeiten (Pfeile). Zeigt: Reihenfolge der Arbeiten, parallele Vorgänge, früheste/späteste Anfangs- und Endzeiten, Pufferzeiten, kritischen Pfad. Hilft bei Terminplanung und Ressourcenbedarf." },
        { cat:"Wirtschaft & Management", q:"Was ist ein Gantt-Diagramm?", a:"Balkendiagramm zur Projektplanung: Zeitachse horizontal, Vorgänge vertikal. Jeder Balken zeigt Dauer und zeitliche Lage eines Vorgangs. Gut für Übersicht, schlecht für Abhängigkeiten (im Gegensatz zum Netzplan). Wird oft mit Netzplan kombiniert." },
        { cat:"Hardware", q:"Was ist der Unterschied zwischen SSD und HDD?", a:"SSD (Solid State Drive): Flash-Speicher, sehr schnell (500–7000 MB/s), leise, stoßfest, weniger heiß, teurer pro GB. HDD (Hard Disk Drive): magnetische rotierende Platten, langsamer (~100-200 MB/s), günstiger pro GB, anfälliger für Stöße." },
        { cat:"Hardware", q:"Was ist Virtualisierung? Nenne einen Vorteil und einen Nachteil.", a:"Virtualisierung: ein physischer Server betreibt mehrere virtuelle Maschinen (VMs) mit eigenem OS. Vorteil: bessere Ressourcenauslastung, Isolation, einfache Skalierung, Snapshots. Nachteil: Overhead durch Hypervisor, bei Ausfall des Hosts fallen alle VMs aus." },
        { cat:"Hardware", q:"Berechne Wirkungsgrad: Eingangsleistung 500W, Ausgangsleistung 425W.", a:"η = P_ab / P_zu × 100% = 425 W / 500 W × 100% = 85%. Verlustleistung: 500 - 425 = 75 W (wird als Wärme abgegeben). Formel merken: η = Nutzleistung / zugeführte Leistung." },
        { cat:"Hardware", q:"Was versteht man unter einem BIOS/UEFI?", a:"BIOS/UEFI (Basic Input/Output System / Unified Extensible Firmware Interface): Firmware auf dem Mainboard. Initialisiert Hardware beim Start (POST), sucht bootfähiges Medium, startet das Betriebssystem. UEFI ist moderner: grafische Oberfläche, Secure Boot, unterstützt große Festplatten (>2 TB)." },
        { cat:"Programmierung", q:"Was ist der Unterschied zwischen Lastenheft und Pflichtenheft?", a:"Lastenheft: erstellt vom Auftraggeber — beschreibt WAS gebraucht wird (Anforderungen aus Kundensicht, funktionale und nicht-funktionale Anforderungen). Pflichtenheft: erstellt vom Auftragnehmer — beschreibt WIE es umgesetzt wird (technische Lösung, konkret und messbar)." },
        { cat:"Programmierung", q:"Was ist der Unterschied zwischen UML und BPMN?", a:"UML (Unified Modeling Language): für Software-Strukturen und -Abläufe (Klassendiagramm, Sequenzdiagramm, Anwendungsfalldiagramm, Aktivitätsdiagramm). BPMN (Business Process Model and Notation): für Geschäftsprozesse und betriebliche Abläufe — wer tut was, wann und in welcher Reihenfolge." },
        { cat:"Programmierung", q:"Erkläre den Unterschied zwischen for-Schleife und while-Schleife.", a:"for-Schleife: verwendet wenn die Anzahl der Wiederholungen bekannt ist (z.B. 'für jeden Eintrag in der Liste'). while-Schleife: verwendet wenn eine Bedingung geprüft wird, Anzahl unbekannt (z.B. 'solange Eingabe ungültig, nochmal fragen'). do-while: mindestens 1x ausführen, dann prüfen." },
        { cat:"Programmierung", q:"Was ist der Unterschied zwischen überwachtem und unüberwachtem Lernen (KI)?", a:"Überwachtes Lernen (Supervised Learning): Training mit gelabelten Daten (Eingabe + bekannte Ausgabe). Algorithmus lernt die Zuordnung. Beispiel: E-Mail als Spam/kein Spam klassifizieren. Unüberwachtes Lernen: keine Labels — Algorithmus findet selbst Muster/Cluster. Beispiel: Kunden nach Kaufverhalten gruppieren." },
        { cat:"Programmierung", q:"Nenne 3 typische Einsatzbereiche von KI in der IT/Systemintegration.", a:"Anomalieerkennung (IT-Sicherheit, Intrusion Detection), Predictive Maintenance (Vorhersage von Hardware-Ausfällen), automatisiertes Testing, Chatbots/Helpdesk-Automatisierung, Spam-Filter, intelligente Netzwerküberwachung, Bilderkennung für QA." },
        { cat:"Programmierung", q:"Was ist maschinelles Lernen (ML)?", a:"Teilgebiet der KI: Algorithmen, die aus Daten lernen ohne explizit programmiert zu werden. Das Modell wird anhand von Trainingsdaten optimiert, um Muster zu erkennen und Vorhersagen zu treffen. Grundlage: Statistik und lineare Algebra." },
        // ============= BETRIEBSSYSTEME =============
        { cat:"Betriebssysteme", q:"Nenne 5 wichtige Linux-Befehle und ihre Funktion.", a:"ls = Verzeichnisinhalt anzeigen. cd = Verzeichnis wechseln. pwd = aktuelles Verzeichnis. cp = kopieren. mv = verschieben/umbenennen. rm = löschen. mkdir = Verzeichnis erstellen. sudo = als root ausführen. chmod = Rechte ändern. ps/top = Prozesse anzeigen." },
        { cat:"Betriebssysteme", q:"Was ist der Unterschied zwischen Windows Home, Pro und Enterprise?", a:"Home: Basic-Funktionen für Consumer. Pro: zusätzlich BitLocker, Remote Desktop, Domänenjoin, Gruppenrichtlinien — für kleine Unternehmen. Enterprise: zusätzlich Direct Access, AppLocker, Device Guard, längerer Support — für große Organisationen mit zentraler Verwaltung." },
        { cat:"Betriebssysteme", q:"Was sind Dateisysteme und nenne 3 Beispiele?", a:"Dateisysteme organisieren Speicher auf Datenträgern. NTFS: Windows-Standard, Journaling, Rechte, Verschlüsselung, große Dateien. ext4: Linux-Standard, Journaling, sehr stabil. APFS: macOS-Standard, optimiert für SSDs, Snapshot-Fähigkeit. FAT32: alt, kompatibel, max. 4GB Dateigröße. exFAT: für große USB-Sticks, plattformübergreifend." },
        { cat:"Betriebssysteme", q:"Was ist der Unterschied zwischen einem Prozess und einem Thread?", a:"Prozess: eigenständiges Programm mit eigenem Speicherbereich (isoliert). Thread: Ausführungsstrang innerhalb eines Prozesses, teilt Speicher mit anderen Threads desselben Prozesses. Prozesse sind schwerer (eigenes Memory), Threads leichter (geteiltes Memory), aber Threads können sich gegenseitig stören (Race Conditions)." },
        { cat:"Betriebssysteme", q:"Was ist ein Dateipfad? Unterschied absolut vs. relativ?", a:"Absoluter Pfad: beginnt am Root (Linux: /home/user/datei.txt, Windows: C:\\Users\\user\\datei.txt). Relativer Pfad: bezogen auf aktuelles Verzeichnis (./datei.txt oder ../andere/datei.txt). Absolute Pfade funktionieren immer, relative nur vom richtigen Ausgangspunkt. In Shell-Skripten oft relative Pfade verwendet." },
        { cat:"Betriebssysteme", q:"Was versteht man unter Benutzerverwaltung in Betriebssystemen?", a:"Verwaltung von Benutzerkonten und deren Berechtigungen. Elemente: Benutzer anlegen/löschen, Passwörter setzen, Gruppen zuordnen, Zugriffsrechte vergeben (ACLs), Kontingente (Speicherlimits), Login-Zeiten einschränken. Windows: Active Directory / lokale Benutzer. Linux: /etc/passwd, /etc/shadow, sudo-Gruppe." },
        { cat:"Betriebssysteme", q:"Was ist APT bei Linux und wie funktioniert es?", a:"Advanced Package Tool: Paketverwaltung für Debian/Ubuntu. Befehle: apt update (Paketlisten aktualisieren), apt upgrade (Pakete aktualisieren), apt install paket (Paket installieren), apt remove paket (deinstallieren), apt search begriff (suchen). Löst Abhängigkeiten automatisch auf, holt Software aus Repositories (/etc/apt/sources.list)." },
        { cat:"Betriebssysteme", q:"Was ist die Windows-Registry?", a:"Zentrale Datenbank für Windows-Konfigurationen. Hierarchisch organisiert in Hives (HKEY_LOCAL_MACHINE, HKEY_CURRENT_USER, etc.). Speichert: Systemeinstellungen, Hardware-Infos, Software-Einstellungen, Benutzerprofile. Bearbeitung: regedit.exe. Vorsicht: Fehler können System unbrauchbar machen. Programme hinterlegen hier ihre Konfiguration." },
        { cat:"Betriebssysteme", q:"Was ist ein Backup und welche Backup-Typen gibt es?", a:"Sicherungskopie von Daten. Vollbackup: alle Daten (langsam, viel Speicher). Inkrementell: nur Änderungen seit letztem Backup (schnell, wenig Speicher, Wiederherstellung komplex). Differentiell: Änderungen seit letztem Vollbackup (mittel). 3-2-1-Regel: 3 Kopien, 2 Medien, 1 externer Standort." },
        { cat:"Betriebssysteme", q:"Was ist eine Umgebungsvariable (Environment Variable)?", a:"Dynamischer Wert im Betriebssystem, der von Programmen genutzt wird. Beispiele: PATH (sucht ausführbare Dateien), HOME/Benutzerprofile (Home-Verzeichnis), TEMP (Temporärverzeichnis). In Linux: export VAR=wert, Windows: set VAR=wert. Wichtig für Software-Installationen, die sich in PATH eintragen." },
        { cat:"Betriebssysteme", q:"Was ist der Unterschied zwischen 32-Bit und 64-Bit Betriebssystemen?", a:"64-Bit kann mehr als 4 GB RAM adressieren (praktisch unbegrenzt), hat mehr Register (schnellere Berechnungen), größere Ganzzahlen. 32-Bit max. ~3,5 GB RAM nutzbar. Moderne Hardware ist 64-Bit, ältere Software manchmal nur 32-Bit. Windows: x86 = 32-Bit, x64 = 64-Bit." },
        // ============= PHASE 1: PROGRAMMIERUNG & LOGIK (18 Karten) =============
        { cat:"Programmierung", q:"Was ist eine Variable?", a:"Container für einen Datenwert, der einen Namen hat und während der Programmlaufzeit geändert werden kann. Deklaration: Datentyp + Variablenname (z.B. int alter = 25;). Die Variable speichert einen Wert im RAM." },
        { cat:"Programmierung", q:"Nenne die 5 Grunddatentypen und gib Beispiele.", a:"int: Ganzzahl (25, -10). float/double: Dezimalzahlen (3.14, -0.5). string: Text (\"Hello\"). boolean: Wahrheitswert (true/false). char: Einzelnes Zeichen ('A'). Wichtig: Jeder Datentyp belegt unterschiedlich viel Speicher." },
        { cat:"Programmierung", q:"Was ist ein Array/eine Liste?", a:"Geordnete Sammlung von Elementen gleichen Datentyps unter einem Namen. Indexiert ab 0. Beispiel: int[] zahlen = {10, 20, 30}; — zahlen[0] = 10. Länge: zahlen.length. Wichtig: Array-Größe ist nach Erstellung fix." },
        { cat:"Programmierung", q:"Erklär die if/else Kontrollstruktur.", a:"Bedingte Verzweigung: if (Bedingung) { Codeblock A } else { Codeblock B }. Die Bedingung wird ausgewertet (true/false). Nur EINER der Blöcke wird ausgeführt. Mehrfache Bedingungen: if-else if-else if-else." },
        { cat:"Programmierung", q:"Wann verwendet man for-Schleifen?", a:"Wenn die Anzahl der Wiederholungen VOR der Ausführung bekannt ist. Syntax: for (int i=0; i<10; i++) { ... }. Bestehend aus: Initialisierung, Bedingung, Inkrementierung. Perfekt für Arrays durchlaufen." },
        { cat:"Programmierung", q:"Wann verwendet man while-Schleifen?", a:"Wenn eine Bedingung geprüft werden soll, die Anzahl der Wiederholungen aber UNBEKANNT ist. Syntax: while (bedingung) { ... }. Beispiel: Eingaben validieren. do-while: mindestens 1x ausführen, dann prüfen." },
        { cat:"Programmierung", q:"Was ist switch-case und wann nutzt man es?", a:"Verzweigung für MEHRERE diskrete Werte (statt vieler if-else). Syntax: switch(variable) { case Wert1: Code; break; case Wert2: Code; break; default: ... }. Default wird ausgeführt, wenn kein case passt." },
        { cat:"Programmierung", q:"Was ist eine Funktion/Methode und warum nutzt man sie?", a:"Wiederverwendbarer Block mit eigenem Namensraum (Scope). Akzeptiert Parameter, führt Logik aus, gibt optional Wert zurück. Vorteile: Code-Wiederverwendung, Lesbarkeit, Wartbarkeit, Modularität." },
        { cat:"Programmierung", q:"Was ist der Unterschied zwischen Parametern und Argumenten?", a:"Parameter: Variablen in der Funktionsdefinition (z.B. int add(int a, int b)). Argumente: tatsächliche Werte beim Funktionsaufruf (z.B. add(5, 3)). Merksatz: Parameter = Definition, Argumente = Aufruf." },
        { cat:"Programmierung", q:"Was ist Pseudocode?", a:"Strukturierte, verständliche Darstellung eines Algorithmus — weder formale Programmiersprache noch natürliche Sprache, sondern dazwischen. Ziel: Logik kommunizieren, nicht Code schreiben. Nutzt oft: EINGABE, VERARBEITUNG, AUSGABE, wenn-dann, Schleifen." },
        { cat:"Programmierung", q:"Was zeigt ein UML-Klassendiagramm?", a:"Struktur von Objekten: Klassenname oben, Attribute (Daten) Mitte, Methoden (Funktionen) unten. Sichtbarkeit: + public, - private, # protected. Beziehungen: Vererbung (Pfeil), Assoziation (Linie), Komposition (Raute)." },
        { cat:"Programmierung", q:"Was ist ein UML-Use-Case-Diagramm?", a:"Stellt dar, WER (Akteur) WELCHE Funktionalität (Use-Case) des Systems nutzt. Zentral: System (Rechteck), außen: Akteure (Strichmännchen), darin: Use-Cases (Ovale). Zeigt Interaktionen ohne technische Details. Für Anforderungsanalyse." },
        { cat:"Programmierung", q:"Erkläre ein UML-Sequenzdiagramm.", a:"Zeigt Abläufe von Objekten über die Zeit (Achsen: Objekt horizontal, Zeit vertikal). Pfeile zeigen Nachrichtenaustausch. Reihenfolge der Interaktionen ist sichtbar. Nutzt man für: Abläufe dokumentieren, Timing prüfen, Kommunikation zwischen Komponenten." },
        { cat:"Programmierung", q:"Was sind Sortieralgorithmen? Nenne 2 Beispiele.", a:"Algorithmen, die Daten in Ordnung bringen. Bubblesort: vergleicht benachbarte Elemente, tauscht wenn nötig — O(n²), einfach. Quicksort: Divide-and-Conquer, wählt Pivot — O(n log n) im Schnitt, schneller. Mergesort: garantiert O(n log n)." },
        { cat:"Programmierung", q:"Was ist der Unterschied zwischen Linearsuche und Binärsuche?", a:"Linearsuche: geht Elemente der Reihe nach durch — O(n), funktioniert auch unsortiert. Binärsuche: halbiert Suchraum jeweils — O(log n), benötigt aber SORTIERTE Daten. Für große Datenmengen: Binärsuche viel schneller." },
        { cat:"Programmierung", q:"Was ist algorithmische Komplexität (Big-O)?", a:"Notation zur Beschreibung von Laufzeit/Speicher bei großem Input (n). O(1) konstant, O(log n) logarithmisch, O(n) linear, O(n²) quadratisch, O(2^n) exponentiell. Merksatz: Große n brauchen kleine Ordnung (O(log n) besser als O(n²))." },
        { cat:"Programmierung", q:"Was ist Modularisierung?", a:"Zerlegung eines großen Programms in kleinere, unabhängige Module (Funktionen, Klassen, Komponenten). Jedes Modul hat eine klare Aufgabe. Vorteile: leichter zu verstehen, zu testen, zu warten, Teams können parallel arbeiten." },
        { cat:"Programmierung", q:"Was ist Fehlerbehandlung (try-catch)?", a:"Mechanismus, um auftretende Fehler zu fangen und kontroliert zu behandeln. try { riskanter Code } catch (Exception e) { Fehlerbehandlung }. Verhindert Programmabsturz. finally-Block läuft immer (Cleanup)." },
        // ============= PHASE 1: NETZWERKE – IPv6 & PROTOKOLLE (8 Karten) =============
        { cat:"Netzwerke", q:"Wie schreibt man IPv6-Adressen?", a:"128 Bit in Hexadezimalschreibweise, 8 Blöcke à 4 Hex-Ziffern (Doppelpunkte trennen). Komprimierung: führende Nullen weglassen, längste Nullserien durch :: ersetzen (nur 1x). Beispiel: 2001:0db8::8a2e:0370:7334." },
        { cat:"Netzwerke", q:"Was ist Stateless Address Autoconfiguration (SLAAC) bei IPv6?", a:"Automatische IP-Adressvergabe ohne DHCP-Server. Host nutzt Router Advertisement (RA) — Router sendet Netzwerkpräfix, Host ergänzt mit seiner MAC-Adresse (EUI-64). Resultat: einzigartige Link-Local-Adresse. Schneller als DHCPv6." },
        { cat:"Netzwerke", q:"Nenne 5 wichtige Unterschiede zwischen IPv6 und IPv4.", a:"1. Adressraum: IPv6 128-Bit (2^128), IPv4 32-Bit (2^32). 2. Keine NAT nötig bei IPv6. 3. IPv6 hat eingebautes IPSec. 4. Kleinere Header-Größe. 5. IPv6 nutzt Link-Local und Global-Unicast von Haus aus." },
        { cat:"Netzwerke", q:"Was ist ein Dual-Stack bei IPv4/IPv6-Migration?", a:"Gerät oder Netzwerk läuft zeitgleich mit IPv4 und IPv6. Jedes Gerät hat beide Adressen. Erlaubt langsame, risikofreie Migration. Alternative: Tunnel (IPv6-Pakete über IPv4), NAT64/DNS64 (Übergang)." },
        { cat:"Netzwerke", q:"Erkläre den TCP-3-Way-Handshake.", a:"Verbindungsaufbau: 1. Client sendet SYN (Seq=x). 2. Server antwortet mit SYN-ACK (Seq=y, Ack=x+1). 3. Client sendet ACK (Seq=x+1, Ack=y+1). Danach: Verbindung ist offen, Daten können fließen. Abbau: FIN, FIN-ACK, ACK." },
        { cat:"Netzwerke", q:"Was sind die Unterschiede zwischen TCP und UDP im Detail?", a:"TCP: Verbindungsorientiert (3-Way-HS), zuverlässig (Bestätigung, Neuübertragung), Fehlerprüfung, Flusskontrolle, Sequenzierung — langsamer. UDP: Verbindungslos, schnell, Best-Effort (Pakete können verloren gehen), kein Handshake. TCP: FTP, HTTP, Email. UDP: VoIP, Video, Gaming, DNS." },
        { cat:"Netzwerke", q:"Wie funktioniert das DNS (Domain Name System)?", a:"Hierarchisches System zur IP-Adressauflösung. Auflösung: 1. Client fragt Resolver (meist beim ISP). 2. Resolver fragt Root-Nameserver. 3. Verweist auf TLD-NS (z.B. .de). 4. TLD verweist auf Authoritative-NS. 5. Authoritative gibt IP-Adresse zurück. Caching auf allen Ebenen." },
        { cat:"Netzwerke", q:"Was passiert beim DHCP-Lease-Management?", a:"DHCP-Server vergibt IP-Adresse mit Lease-Time (z.B. 24h). Nach 50% der Lease-Time: Client versucht Erneuerung (Reacquisition). Nach 87,5%: Client fragt anderen Server. Nach 100%: IP wird freigegeben. Länger laufende Leases = mehr Stabilität, kürzere = bessere Ressourcennutzung." },
        // ============= PHASE 1: IT-SICHERHEIT VERTIEFUNG (12 Karten) =============
        { cat:"IT-Sicherheit", q:"Erkläre Confidentiality (C) aus dem CIA-Prinzip.", a:"Vertraulichkeit: Daten dürfen nur von Berechtigten gelesen werden. Technische Maßnahmen: Verschlüsselung, Zugriffskontrolle, Authentifizierung. Beispiel: Passwort schützt gegen unerlaubten Zugriff. Verletzung: Datenklau, Spionage." },
        { cat:"IT-Sicherheit", q:"Erkläre Integrity (I) aus dem CIA-Prinzip.", a:"Integrität: Daten dürfen weder unbemerkt noch unberechtigt geändert werden. Technische Maßnahmen: Hashing, digitale Signaturen, Checksummen, Versionskontrolle. Beispiel: HMAC prüft, ob Datei unterwegs geändert wurde. Verletzung: Datenmanipulation, Trojan, Malware." },
        { cat:"IT-Sicherheit", q:"Erkläre Availability (A) aus dem CIA-Prinzip.", a:"Verfügbarkeit: Systeme müssen für Berechtigte erreichbar/nutzbar sein. Technische Maßnahmen: Redundanz, Clustering, Disaster Recovery, DDoS-Mitigation. Beispiel: RAID 1 Spiegeln gegen Festplattenausfall. Verletzung: DoS-Angriff, Ransomware, Hardwareausfälle." },
        { cat:"IT-Sicherheit", q:"Nenne die ersten 5 DSGVO-Grundsätze der Datenschutzverarbeitung.", a:"1. Rechtmäßigkeit, Verarbeitung transparent (mit Consent). 2. Zweckbindung (Daten nur für angegebenen Zweck). 3. Datensparsamkeit (nur notwendige Daten). 4. Richtigkeit (korrekte, aktuelle Daten). 5. Speicherbegrenzung (nicht länger speichern als nötig)." },
        { cat:"IT-Sicherheit", q:"Nenne die letzten 2 DSGVO-Grundsätze.", a:"6. Integrität und Vertraulichkeit: Daten vor Zerstörung, Verlust, Missbrauch schützen (mit Maßnahmen). 7. Rechenschaftspflicht: Unternehmen muss Einhaltung nachweisen können. Betroffene haben Rechte: Auskunft, Berichtigung, Löschung (Recht auf Vergessenwerden)." },
        { cat:"IT-Sicherheit", q:"Was ist symmetrische Verschlüsselung? Nenne ein Beispiel.", a:"Ein Schlüssel für Ver- UND Entschlüsselung. Schnell, aber Problem: sicherer Schlüsselaustausch. Beispiel: AES (Advanced Encryption Standard) — 128, 192, oder 256-Bit-Schlüssel. Nutzen: Datenverschlüsselung auf Festplatte, WhatsApp-Nachrichten." },
        { cat:"IT-Sicherheit", q:"Was ist asymmetrische Verschlüsselung? Nenne ein Beispiel.", a:"Zwei verschiedene Schlüssel: öffentlicher Schlüssel (verteilt) für Verschlüsselung, privater Schlüssel (geheim) für Entschlüsselung. Langsamer als symmetrisch, aber kein Schlüsselaustauschproblem. Beispiel: RSA (Rivest-Shamir-Adleman) mit 2048 oder 4096-Bit-Keys. Nutzen: Email-Verschlüsselung (PGP), HTTPS." },
        { cat:"IT-Sicherheit", q:"Was ist Hashing und welche Algorithmen gibt es?", a:"Einseitige Funktion: beliebige Eingabe → feste Hashwert-Länge. Nicht umkehrbar! MD5 (unsicher), SHA-1 (unsicher), SHA-256 (sicher), SHA-512. Nutzen: Passwörter speichern (plus Salt), Dateiintegrität prüfen, Blockchain. Wichtig: Zwei Eingaben sollten NICHT den gleichen Hash haben (Kollision vermeiden)." },
        { cat:"IT-Sicherheit", q:"Was ist eine digitale Signatur?", a:"Asymmetrisches Verfahren: Absender hasht Daten, verschlüsselt Hash mit privatem Schlüssel (Signatur). Empfänger entschlüsselt mit öffentlichem Schlüssel, vergleicht Hashes. Bietet: Authentifizierung (wer ist der Absender?), Nicht-Abstreitbarkeit (Absender kann nicht leugnen). Nutzen: Email, Code-Signierung." },
        { cat:"IT-Sicherheit", q:"Was ist ein digitales Zertifikat und wer stellt es aus?", a:"Dokument mit Absender-Identität, öffentlichem Schlüssel, Gültigkeitsdauer, Signatur. Ausgestellt von Certification Authority (CA). Validierung: Browser prüft Zertifikat beim HTTPS-Verbindung. Self-Signed = Browser warnt. Extended Validation (EV) = grüne Adressleiste." },
        { cat:"IT-Sicherheit", q:"Erkläre den Diffie-Hellman Schlüsselaustausch.", a:"Verfahren zur Einigung auf gemeinsamen Secret zwischen zwei Parteien über unsicheren Kanal. 1. Beide einigen sich auf Primzahl p und Basis g. 2. Alice wählt secret a, Bob wählt secret b. 3. Alice sendet g^a mod p, Bob sendet g^b mod p. 4. Beide berechnen gemeinsamen Schlüssel g^(ab) mod p. Abhörer kennt g^a und g^b, aber nicht ab." },
        // ============= PHASE 2: HARDWARE – SCHNITTSTELLEN (5 Karten) =============
        { cat:"Hardware", q:"Was ist USB? Nenne USB-Standards und ihre Geschwindigkeiten.", a:"Universal Serial Bus: standard Schnittstelle für Peripherie. USB 2.0: 480 Mbit/s (High-Speed). USB 3.0/3.1: 5 Gbit/s / 10 Gbit/s. USB-C: neuerer Stecker (reversibel, Power Delivery). USB 4: 40 Gbit/s, Thunderbolt-kompatibel. Wichtig: Rückwärts kompatibel." },
        { cat:"Hardware", q:"Was ist PCIe (PCI Express)?", a:"Interne Schnittstelle für Grafikkarten, SSDs, Netzwerkkarten. PCIe 3.0: 16 Gbit/s pro Lane, PCIe 4.0: 32 Gbit/s, PCIe 5.0: 64 Gbit/s. Lanes: x1, x4, x8, x16 (Bandbreite multipliziert sich). Vollständig hot-pluggable (Geräte können bei Betrieb installiert werden)." },
        { cat:"Hardware", q:"Vergleiche SATA, M.2 und NVMe für SSD-Speicher.", a:"SATA: 3,5 Gbit/s, 2,5\" Formfaktor, älter, günstiger. M.2: nur Formfaktor (22x80mm), über SATA oder NVMe. NVMe (NVM Express): Protocol über PCIe — PCIe 3.0: 3,5 GB/s, PCIe 4.0: 7 GB/s. NVMe = sehr schnell, M.2 SATA = langsamer aber möglich." },
        { cat:"Hardware", q:"Nenne die wichtigsten Speicherschnittstellen und ihre Latenzen.", a:"SRAM (Cache): <10 ns. DRAM (RAM): 50–100 ns. SSD-NAND: 10–50 µs. HDD: 5–10 ms. Diese Hierarchie erklärt, warum Cache zentral ist: 1000x schneller als RAM, 100.000x schneller als HDD!" },
        { cat:"Hardware", q:"Was ist die Ethernet-Schnittelle? Welche Geschwindigkeiten gibt es?", a:"Standard-Schnittstelle für Netzwerkverbindungen. Fast Ethernet (100 Mbit/s), Gigabit (1 Gbit/s = 1000 Mbit/s), 10-Gigabit (10 Gbit/s), 25/40/100-Gigabit. RJ45 ist Standard (8 Pins). Cat5e: 1 Gbit/s, Cat6: 1–10 Gbit/s (je nach Länge), Cat7/8: bis 100 Gbit/s." },
        // ============= PHASE 2: VIRTUALISIERUNG (4 Karten) =============
        { cat:"Hardware", q:"Was ist Virtualisierung und welche Vorteile hat sie?", a:"Technique zur Ausführung mehrerer virtueller Maschinen (VMs) auf einem physischen Host. Jede VM hat eigenes OS und Ressourcen (CPU, RAM, Speicher). Vorteile: bessere Auslastung, Isolation (Sicherheit), einfache Skalierung, Schnelle Bereitstellung, Snapshots ermöglichen schnelle Recovery." },
        { cat:"Hardware", q:"Erkläre den Unterschied zwischen Hypervisor Typ 1 und Typ 2.", a:"Typ 1 (Bare-Metal): läuft direkt auf Hardware, verwaltet VMs. Schneller, sicherer. Beispiele: vSphere/ESXi, Hyper-V (Server), KVM. Typ 2 (Hosted): läuft als Anwendung auf Host-OS (Windows, Linux). Mehr Overhead. Beispiele: VirtualBox, VMware Workstation. Typ 1 für Produktivumgebungen bevorzugt." },
        { cat:"Hardware", q:"Was ist ein Snapshot bei virtuellen Maschinen?", a:"Punkt-in-Zeit-Abbild des kompletten VM-Zustands (Festplatte + RAM-Inhalt). Erlaubt schnelle Rückkehr zu bekanntem Zustand. Snapshots können gekoppelt sein (Chain) — Speicher nutzt nur Unterschiede (Differenzen) zum Basis-Image. Vorsicht: lange Snapshot-Ketten verlangsamen VM." },
        { cat:"Hardware", q:"Was ist der Unterschied zwischen Containern und VMs?", a:"VMs: komplettes OS pro Container, virtualisiert Hardware. Schwer, langsam, >GB pro VM. Container: teilen Host-OS-Kernel, nur App-Code + Abhängigkeiten (Docker). Leicht, schnell, MB pro Container. Container = schnelle Deployment, VMs = stärkere Isolation für Sicherheit." },
        // ============= NETZWERKE – WAN & FRAME RELAY (2 Karten) =============
        { cat:"Netzwerke", q:"Was ist der Unterschied zwischen Frame Relay und MPLS?", a:"Frame Relay: historische Paketvermittlung mit PVCs, einfach aber begrenzte QoS. MPLS: modernes Label-Switching, schnellere Weiterleitung, bessere QoS, Traffic Engineering. MPLS ist der Nachfolger von Frame Relay für WAN-Verbindungen." },
        { cat:"Netzwerke", q:"Was ist ein PVC in Frame Relay?", a:"Permanent Virtual Circuit: eine feste virtuelle Verbindung zwischen zwei Standorten im Frame-Relay-Netz. Im Gegensatz zu SVC (Switched Virtual Circuit), das dynamisch aufgebaut wird, ist ein PVC permanent eingerichtet." },
        // ============= MOBILFUNK & SATELLITEN =============
        { cat:"Mobilfunk & Satelliten", q:"Nenne die 5 Mobilfunkgenerationen (1G bis 5G) mit ihrem Hauptmerkmal.", a:"1G (1978): Analog, nur Sprache. 2G/GSM (1993): Digital, SMS. 3G/UMTS (2003): Mobiles Internet. 4G/LTE (2012): Multimedia, bis 1 Gbit/s. 5G (2019): Echtzeit, IoT, bis 10 Gbit/s, < 1ms Latenz." },
        { cat:"Mobilfunk & Satelliten", q:"Was ist das Zellprinzip im Mobilfunk?", a:"Fläche wird in Zellen unterteilt, jede mit einer Basisstation. Zellen sind hexagonal angeordnet. Je nach Größe: Makrozellen (km), Mikrozellen (100-500m), Picozellen (<100m), Femtozellen (<10m). Frequenzen können wiederverwendet werden (räumliche Trennung)." },
        { cat:"Mobilfunk & Satelliten", q:"Was ist der Unterschied zwischen ionisierender und nicht-ionisierender Strahlung?", a:"Nicht-ionisierend (< 300 GHz): Kann keine Elektronen aus Atomen entfernen — unbedenklich für Mobilfunk (Handy, WLAN). Ionisierend (> 300 GHz): Kann Elektronen entfernen, potenziell gesundheitsschädlich — UV, Röntgen, radioaktive Strahlung." },
        { cat:"Mobilfunk & Satelliten", q:"Was ist der Unterschied zwischen GPS, GLONASS, Galileo und BeiDou?", a:"Vier globale GNSS-Systeme: GPS (USA, 24+ Satelliten), GLONASS (Russland, 24+ Satelliten), Galileo (EU, 30 Satelliten, unabhängig), BeiDou (China, 35 Satelliten, globale Abdeckung seit 2020). Moderne Empfänger nutzen Multi-GNSS für höhere Genauigkeit." },
        { cat:"Mobilfunk & Satelliten", q:"Was ist Multi-GNSS und welchen Vorteil bietet es?", a:"Gleichzeitige Nutzung mehrerer Satellitennavigationssysteme (GPS + GLONASS + Galileo + BeiDou). Vorteil: Höhere Genauigkeit (mehr Satelliten sichtbar, bessere Geometrie) und bessere Zuverlässigkeit (Redundanz bei Ausfall eines Systems)." },
        { cat:"Mobilfunk & Satelliten", q:"Was ist EGNOS und warum ist es wichtig?", a:"European Geostationary Navigation Overlay Service: satellitengestütztes Korrektursystem für GNSS. Verbessert die Genauigkeit von 3–5 Metern auf 1–2 Meter. Wichtig für sicherheitskritische Anwendungen wie Luftfahrt (Präzisionsanflüge) und Seefahrt." },
        { cat:"Mobilfunk & Satelliten", q:"Was ist der Unterschied zwischen LEO und GEO Satelliten?", a:"LEO (Low Earth Orbit): 200-2.000 km Höhe, niedrige Latenz (~30ms), z.B. Starlink. GEO (Geostationär): ~36.000 km Höhe, hohe Latenz (~250ms), Satellit scheint stationär. LEO erfordert mehr Satelliten für globale Abdeckung." },
        { cat:"Mobilfunk & Satelliten", q:"Was ist Starlink und was unterscheidet es von traditionellen Satelliteninternet?", a:"SpaceX-Projekt mit Tausenden LEO-Satelliten (~550 km). Deutlich niedrigere Latenz (~30ms) als geostationäre Satelliten (~250ms). Ermöglicht Breitband-Internet in ländlichen/abgelegenen Gebieten. Konstellation aus vielen kleinen Satelliten statt weniger großer GEO-Satelliten." },
        { cat:"Mobilfunk & Satelliten", q:"Was ist Roaming im Mobilfunk?", a:"Nutzung von Mobilfunkdiensten außerhalb des eigenen Netzbetreibers durch bilaterale Vereinbarungen. Ermöglicht Konnektivität im Ausland. Abrechnung erfolgt über den Heimatprovider (oft teurer). Wichtig für nahtlose mobile Kommunikation über Netzwerkgrenzen hinweg." },
        { cat:"Mobilfunk & Satelliten", q:"Nenne 3 wichtige Einsatzgebiete von 5G.", a:"1. Autonomes Fahren (Echtzeit-Kommunikation zwischen Fahrzeugen). 2. Industrie 4.0 / IoT (vernetzte Fabriken, massive Geräteanzahl). 3. Telemedizin (Fernoperationen, Gesundheitsmonitoring). Weitere: Smart Cities, Echtzeit-Gaming, AR/VR." },
        { cat:"Mobilfunk & Satelliten", q:"Warum nutzt 5G höhere Frequenzen als 4G?", a:"Höhere Frequenzen (bis 100 GHz) ermöglichen höhere Datenraten und geringere Latenz. Aber: Geringere Reichweite und schlechtere Gebäudedurchdringung. Deshalb braucht 5G mehr kleinere Basisstationen (Mikro-/Picozellen) als 4G mit Makrozellen." },
        { cat:"Mobilfunk & Satelliten", q:"Was ist ein GNSS-Empfänger und wie funktioniert er?", a:"Global Navigation Satellite System Empfänger: Gerät das Signale von Navigationssatelliten empfängt. Mindestens 4 Satelliten nötig für 3D-Positionsberechnung (Längengrad, Breitengrad, Höhe) durch Triangulation der Signallaufzeiten." },
        { cat:"Mobilfunk & Satelliten", q:"Nenne 3 Anwendungsbereiche von Satellitensystemen.", a:"1. Navigation (GPS, Galileo in Fahrzeugen, Smartphones). 2. Kommunikation (Satellitentelefonie, Internet wie Starlink, TV-Übertragung). 3. Erdbeobachtung (Wettervorhersage, Klimaforschung, Copernicus, Katastrophenmanagement)." }
      ];

      // --- NAV ---
      var navBtns = document.querySelectorAll('.lk-nav-btn');
      navBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var page = btn.getAttribute('data-page');
          navBtns.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          document.querySelectorAll('.lk-page').forEach(function(p) { p.classList.remove('active'); });
          document.getElementById('lk-page-' + page).classList.add('active');
          if (page === 'alle') renderAllCards();
        });
      });

      // --- FLASHCARD LOGIC ---
      var fcActive = cards.slice(), fcIdx = 0, fcCorrect = 0, fcShown = false;
      var fcActiveCats = {};
      cards.forEach(function(c) { fcActiveCats[c.cat] = true; });

      function renderFilters() {
        var cats = [];
        var seen = {};
        cards.forEach(function(c) { if (!seen[c.cat]) { seen[c.cat] = true; cats.push(c.cat); } });
        var el = document.getElementById('lk-filters');
        el.innerHTML = '';
        cats.forEach(function(c) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'lk-filter-btn on';
          btn.textContent = c;
          btn.setAttribute('data-cat', c);
          btn.addEventListener('click', function() { toggleCat(c, btn); });
          el.appendChild(btn);
        });
      }

      function toggleCat(cat, btn) {
        var activeCount = 0;
        for (var k in fcActiveCats) { if (fcActiveCats[k]) activeCount++; }
        if (fcActiveCats[cat]) {
          if (activeCount > 1) { fcActiveCats[cat] = false; btn.classList.remove('on'); }
        } else {
          fcActiveCats[cat] = true; btn.classList.add('on');
        }
        fcActive = cards.filter(function(c) { return fcActiveCats[c.cat]; });
        fcIdx = 0; fcCorrect = 0;
        document.getElementById('lk-summary').style.display = 'none';
        document.getElementById('lk-card').style.display = 'flex';
        fcRender();
      }

      function fcRender() {
        if (fcIdx >= fcActive.length) { fcShowSummary(); return; }
        var c = fcActive[fcIdx];
        fcShown = false;
        var tag = document.getElementById('lk-cat-tag');
        var col = catColors[c.cat] || '#64748b';
        tag.textContent = c.cat;
        tag.style.background = col + '22';
        tag.style.color = col;
        document.getElementById('lk-q').textContent = c.q;
        document.getElementById('lk-a').textContent = c.a;
        document.getElementById('lk-a').style.display = 'none';
        document.getElementById('lk-hint').style.display = '';
        document.getElementById('lk-btn-row').style.display = 'none';
        document.getElementById('lk-counter').textContent = (fcIdx + 1) + ' / ' + fcActive.length;
        document.getElementById('lk-score').textContent = '✓ ' + fcCorrect + ' gewusst';
        document.getElementById('lk-prog').style.width = (fcIdx / fcActive.length * 100) + '%';
      }

      document.getElementById('lk-card').addEventListener('click', function() {
        if (fcShown) return;
        fcShown = true;
        document.getElementById('lk-a').style.display = 'block';
        document.getElementById('lk-hint').style.display = 'none';
        document.getElementById('lk-btn-row').style.display = 'flex';
      });

      document.getElementById('lk-rate-yes').addEventListener('click', function() { fcCorrect++; fcIdx++; fcRender(); });
      document.getElementById('lk-rate-no').addEventListener('click', function() { fcIdx++; fcRender(); });
      document.getElementById('lk-skip').addEventListener('click', function() { fcIdx++; fcRender(); });

      function fcShowSummary() {
        document.getElementById('lk-card').style.display = 'none';
        document.getElementById('lk-btn-row').style.display = 'none';
        document.getElementById('lk-summary').style.display = 'block';
        document.getElementById('lk-sum-txt').textContent = fcCorrect + ' / ' + fcActive.length + ' gewusst 🎉';
        document.getElementById('lk-prog').style.width = '100%';
      }

      document.getElementById('lk-restart').addEventListener('click', function() {
        fcIdx = 0; fcCorrect = 0;
        fcActive = cards.filter(function(c) { return fcActiveCats[c.cat]; });
        fcActive.sort(function() { return Math.random() - 0.5; });
        document.getElementById('lk-summary').style.display = 'none';
        document.getElementById('lk-card').style.display = 'flex';
        fcRender();
      });

      // --- ALL CARDS ---
      function renderAllCards() {
        var list = document.getElementById('lk-cards-list');
        var byCat = {};
        cards.forEach(function(c) { if (!byCat[c.cat]) byCat[c.cat] = []; byCat[c.cat].push(c); });
        var html = '';
        var catNames = Object.keys(byCat);
        catNames.forEach(function(cat) {
          var col = catColors[cat] || '#64748b';
          html += '<h3 style="font-size:13px;font-weight:500;color:' + col + ';margin:20px 0 8px;">' + cat + '</h3>';
          byCat[cat].forEach(function(c) {
            html += '<div class="lk-card-item">';
            html += '<div class="lk-card-head" onclick="this.nextElementSibling.classList.toggle(\'open\')">';
            html += '<span>' + c.q + '</span>';
            html += '<span style="color:#64748b;font-size:18px;margin-left:12px;">+</span>';
            html += '</div>';
            html += '<div class="lk-card-body">' + c.a + '</div>';
            html += '</div>';
          });
        });
        list.innerHTML = html;
      }

      // INIT
      renderFilters();
      fcActive.sort(function() { return Math.random() - 0.5; });
      fcRender();
    })();
  </script>
</StarlightPage>
